{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    // Инкрементальную сборку выключаем: nest-cli ставит deleteOutDir: true, и при
    // живом tsconfig.build.tsbuildinfo tsc считает, что эмитить нечего, — dist
    // остаётся пустым без ошибки (проверено локально: 12:52 build → пустой dist).
    // Для билда это не потеря: он и так полный (workspace + Docker layer cache).
    "incremental": false,
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"],
      "@modules/*": ["./src/modules/*"],
      "@casino/shared-types": ["../../packages/shared-types/dist"],
      "@casino/shared-utils": ["../../packages/shared-utils/dist"],
      "@casino/shared-config": ["../../packages/shared-config/dist"],
      "@casino/database": ["../../packages/database/dist"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "test"]
}
