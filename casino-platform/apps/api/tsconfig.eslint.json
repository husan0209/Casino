{
  // Файл двойного назначения: type-aware правила ESLint и `pnpm typecheck`
  // (`tsc --noEmit -p tsconfig.eslint.json`). Оба гейта должны видеть одну область —
  // src + test, иначе типизация спеков не проверяется нигде (tsconfig.json берёт только src).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Скрипты проверки в test/*.js (di-graph.check.js, affiliate-flow.check.js,
    // di-inject-audit.js) — автономные Node-программы на CommonJS. Без allowJs
    // парсер @typescript-eslint не может построить для них type information и
    // падает с «The file was not found in any of the provided projects».
    // allowJs действует только на этот файл: сборку (tsconfig.json) не трогает.
    "allowJs": true,
    "checkJs": false
  },
  // `.eslintrc.js` — сам конфиг api: lint-staged линтует каждый staged-файл, и без
  // него в include type-aware правила падают «Parsing error: ... TSConfig does not
  // include this file» ещё до того, как успевают проверить содержимое.
  "include": ["src", "test", ".eslintrc.js"],
  "exclude": ["node_modules", "dist"]
}
