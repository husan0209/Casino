#!/bin/sh
# Храповик техдолга (ratchet): правила архитектуры включены в error, но
# СУЩЕСТВУЮЩИЙ долг заморожен в базлайнах tech-debt/<name>.txt.
#
#   tech-debt check <name>...  — сравнение числа нарушений per-file:
#                                факт > базлайн → FAIL (долг вырос);
#                                факт < базлайн → STALE (часть погашена,
#                                базлайн надо ужмять) — тоже ненулевой exit,
#                                иначе храповик вечно шумит и его перестают
#                                замечать (G18 шумел 30.09–02.10 именно так);
#                                равно → OK.
#                                Флаг --allow-stale понижает STALE до warning
#                                с exit 0 (для переходных прогонов CI).
#   tech-debt gen   <name>...  — перезаписать базлайн текущим состоянием
#                                (только осознанно: после разбора части долга
#                                или при добавлении нового правила).
#   tech-debt detect <name>    — ТОЛЬКО печать факта (без базлайна и без
#                                записи). Нужен негативному тесту
#                                scripts/bin/guard-selftest, который гоняет
#                                ЭТОТ ЖЕ детектор по copy-дереву с ловушкой.
#   tech-debt list             — имена всех правил.
#
# ENV TECH_DEBT_ROOT=<каталог> — перенести сканирование (и DIR) в чужое дерево.
# Разрешено у `detect` и `check` (check только читает базлайн), запрещено у
# `gen`: подменённый корень не должен оставить ловушку в вечном базлайне.
#
# Exit codes: 0 — OK (или STALE при --allow-stale); 1 — долг вырос;
# 2 — ошибка использования / нет базлайна / неизвестное правило;
# 3 — долг погашен, базлайн не ужмят.
#
# Формат базлайна: `путь<TAB>количество` (для use-case-specs — просто путь
# на строку, это то же самое, что количество 1). Путь — от корня
# casino-platform, слэши всегда «/».
# Один и тот же детектор используется и в gen, и в check — правь его здесь,
# а не в workflow. CI вызывает `sh scripts/bin/tech-debt check <name>`.

set -u

if [ -n "${TECH_DEBT_ROOT:-}" ]; then
  cd "$TECH_DEBT_ROOT" 2>/dev/null || {
    echo "tech-debt: TECH_DEBT_ROOT='$TECH_DEBT_ROOT' — нет такого каталога" >&2
    exit 2
  }
else
  cd "$(git rev-parse --show-toplevel 2>/dev/null)/casino-platform" 2>/dev/null ||
    cd "$(dirname "$0")/../.."
fi
DIR=tech-debt

# ── Карта владения моделями Prisma ───────────────────────────────────────
# ЭТО И ЕСТЬ ИСТОЧНИК ИСТИНЫ правила `foreign-writes`: формат
# `<МодельИзSchema>:<модуль-владелец>`, модуль — каталог apps/api/src/modules.
# Карту пополняет ТОТ, кто добавляет модель в packages/database/prisma/schema.prisma:
# детектор отказывается работать, если модели нет здесь (см. FOREIGN_WRITES_SCHEMA
# ниже) — иначе новая таблица стала бы для гарда невидимкой, ровно тем вакуумом,
# на котором умер прежний G7.
#
# Как выбирается владелец (сверено с docs/MODULE_BOUNDARIES.md §«Ключевые таблицы»):
#   • владелец — модуль, чей репозиторий СТРОКУ СОЗДАЁТ (INSERT), а не тот, кто
#     её читает: read-only доступ между модулями легален по ADR GAP-51;
#   • `users` → auth: `user.create` живит только auth (`user.repository.prisma.ts`,
#     регистрация email/Google/Telegram); MODULE_BOUNDARIES §3.2 перечисляет
#     таблицу и у users, но users создаёт только профиль/настройки;
#   • `sessions` → auth (§3.2 NB: «выпуск refresh-токенов — в auth»), поэтому
#     отзывы сессий админом, users-модулем и клинером maintenance — чужие записи;
#   • `exchange_rates` → maintenance (§18.6: запись курсов — её джоба, geo лишь читает);
#   • `audit_logs`/`system_settings`/`admin_users` → admin (§12.3, §13, §9a.2).
# Владельцы взяты из docs/MODULE_BOUNDARIES, а не из названий модулей:
#   User    — §3.2 (users: «users (основная, базовая)») + §2.1 (auth: регистрация)
#   Session — §2.1 (auth: session management) + §3.1 (users: terminate/просмотр)
# Где граница разделена по ответственностям, у модели два владельца — гард тогда
# ловит запись ТРЕТЬИХ модулей (кейс GAP-62: affiliate писал в users), а не
# превращает в долг законную работу обоих владельцев.
MODEL_OWNERS='
User:auth User:users AuthProvider:auth Session:auth Session:users EmailVerification:auth PasswordReset:auth TermsAcceptance:auth
UserProfile:users UserSettings:users KycProfile:kyc KycDocument:kyc
AdminUser:admin AuditLog:admin SystemSetting:admin
WalletAccount:wallet LedgerEntry:wallet
PaymentRequest:payments PaymentCallback:payments ExchangeRate:maintenance
GameProvider:casino Game:casino GameSession:casino GameRound:casino
GameTransaction:casino GameFavorite:casino
SupportTicket:support SupportMessage:support ReferralReward:referrals
Affiliate:affiliate AffiliateClick:affiliate AffiliateAttribution:affiliate
AffiliateCommission:affiliate Notification:notifications
'
PRISMA_SCHEMA='packages/database/prisma/schema.prisma'

# ── Детекторы: на stdout — текущее состояние долга в формате базлайна ──
detect() {
  case "$1" in    # Сырой new Error() вместо AppError-подклассов (AI_DEVELOPMENT_RULES §5)
    raw-error)
      grep -rnE 'new Error\(' apps/api/src --include='*.ts' 2>/dev/null |
        grep -vE '\.spec\.ts:|\.test\.ts:' |
        cut -d: -f1 | sed 's|\\|/|g' | sort | uniq -c |
        awk '{print $2 "\t" $1}' | sort
      ;;
    # NestJS built-in exceptions вместо AppError (AI_DEVELOPMENT_RULES §5)
    nest-exceptions)
      grep -rnE 'new (HttpException|BadRequestException|NotFoundException|UnauthorizedException|ForbiddenException)\(' \
        apps/api/src --include='*.ts' 2>/dev/null |
        grep -vE '\.spec\.ts:|\.test\.ts:' |
        cut -d: -f1 | sed 's|\\|/|g' | sort | uniq -c |
        awk '{print $2 "\t" $1}' | sort
      ;;
    # Подавления правил в продакшн-коде (burn-down: каждое — либо чинить,
    # либо переносить в overrides .eslintrc.js с обоснованием, QUALITY_GATES §2.1.1)
    eslint-disable)
      grep -rn 'eslint-disable' apps/api/src apps/web/src apps/admin/src packages/*/src \
        --include='*.ts' --include='*.tsx' 2>/dev/null |
        grep -vE '\.spec\.ts:|\.test\.ts:' |
        cut -d: -f1 | sed 's|\\|/|g' | sort | uniq -c |
        awk '{print $2 "\t" $1}' | sort
      ;;
    # Денежные поля, типизированные как number (AI_DEVELOPMENT_RULES §1).
    # `total` НЕ проверяется: в пагинации это счётчик записей, не деньги.
    money-number)
      grep -rnE '(balance|amount|price|fee|profit|reward|lockedBalance|availableBalance)[[:space:]]*\??:[[:space:]]*number' \
        apps/api/src packages/*/src --include='*.ts' 2>/dev/null |
        grep -vE '\.spec\.ts:' |
        cut -d: -f1 | sed 's|\\|/|g' | sort | uniq -c |
        awk '{print $2 "\t" $1}' | sort
      ;;
    # Use-case без теста (CONVENTIONS §11). Тест считается найденным, если:
    # (а) есть соседний .spec.ts, ИЛИ (б) имя класса упоминается в любом спеке
    # apps/api/test/ (конвенция репо: спеки живут в test/, не рядом с кодом).
    # Упоминание ищется ЦЕЛЫМ СЛОВОМ (-w): подстрокой `LoginUseCase` матчился
    # внутри `TelegramLoginUseCase`, и непокрытый кейс молча считался покрытым.
    use-case-specs)
      find apps/api/src/modules -name '*.use-case.ts' ! -name '*.spec.ts' 2>/dev/null |
        sed 's|\\|/|g' | sort |
        while IFS= read -r uc; do
          [ -f "${uc%.ts}.spec.ts" ] && continue
          BASE=$(basename "$uc" .use-case.ts)
          # Механический camelCase от имени файла не всегда и есть имя класса
          # (google-oauth.use-case.ts → GoogleOAuthUseCase, process-nowpayments-
          # webhook → ProcessNOWPaymentsWebhookUseCase). Имя берётся из файла,
          # вывод имени из пути — только запасной вариант: иначе гард ловил бы
          # «покрытие» по строке-опечатке в комментарии, а не по реальному классу.
          DERIVED=$(printf '%s' "$BASE" | awk -F'-' '{o="";for(i=1;i<=NF;i++)o=o toupper(substr($i,1,1)) substr($i,2); print o "UseCase"}')
          CLS=$(grep -oE 'export class [A-Za-z0-9_]*UseCase' "$uc" 2>/dev/null | head -1 | awk '{print $3}')
          [ -n "$CLS" ] || CLS="$DERIVED"
          grep -rqw "$CLS" apps/api/test --include='*.spec.ts' 2>/dev/null && continue
          printf '%s\n' "$uc"
        done
      ;;
    # Сервис без теста. Скоуп — любой *.service.ts внутри apps/api/src/modules:
    # и application-слой (DashboardService, NotificationService), и
    # infrastructure-сервисы (подпись админских токенов, argon2-хешер, очередь
    # писем). Критерий покрытия ЗАМЕТНО строже, чем у use-case-specs, и вот почему:
    # DI-wiring-спеки (admin-module-wiring.spec.ts, admin-contract.spec.ts)
    # перечисляют ИМЕНА всех провайдеров модуля — при мягком критерии «упомянут»
    # сервис считался бы покрытым, хотя ни один ассерт его поведение не проверяет.
    # Это ровно тот вакуумный гард, из-за которого G7 когда-то протух.
    # Покрытием считается только:
    #   (а) соседний файл <имя>.service.spec.ts, ИЛИ
    #   (б) в любом *.spec.ts (в test/ и рядом с кодом в src/) есть вызов
    #       конструктора `new <Class>(` — то есть спека реально собирает сервис.
    # Имя класса читается из файла, а не выводится из пути: admin-jwt.service.ts
    # содержит класс AdminAuthService, mechanical camelCase дал бы бы AdminJwtService
    # и гард искал бы в спеках несуществующее имя.
    service-specs)
      find apps/api/src/modules -name '*.service.ts' ! -name '*.spec.ts' 2>/dev/null |
        sed 's|\\|/|g' | sort |
        while IFS= read -r svc; do
          [ -f "${svc%.ts}.spec.ts" ] && continue
          CLS=$(grep -oE 'export class [A-Za-z0-9_]+' "$svc" 2>/dev/null | head -1 | awk '{print $3}')
          [ -n "$CLS" ] || continue
          grep -rlE "new ${CLS}[[:space:]]*\(" apps/api/test apps/api/src --include='*.spec.ts' 2>/dev/null |
            grep -q . && continue
          printf '%s\n' "$svc"
        done
      ;;
    # Кросс-модульные deep-импорты мимо Facade (MODULE_BOUNDARIES.md).
    # Разрешено (публичный API модуля): импорт *.facade и guard'ов (*.guard) —
    # MODULE_BOUNDARIES §2.5 объявляет JwtAuthGuard/RolesGuard экспортом auth,
    # решение В6 (2026-09-28). queues/, common/ и прочее вне src/modules
    # модулями не считаются.
    cross-module-imports)
      MODS=$(ls -1 apps/api/src/modules | tr '\n' '|' | sed 's/|$//')
      grep -rnoE "from '[^']+'" apps/api/src/modules --include='*.ts' 2>/dev/null |
        grep -vE '\.spec\.ts:' |
        awk -F"'" -v mods="$MODS" '
          {
            imp = $2
            f1 = $1; sub(/from$/, "", f1); sub(/[ ]$/, "", f1)
            split(f1, p, ":"); file = p[1]; gsub(/\\/, "/", file)
            if (imp !~ ("/(" mods ")/(domain|application|infrastructure|presentation)(/|$)")) next
            if (imp ~ /\.facade$/) next
            if (imp ~ /\.guard$/) next
            match(file, /modules\/[a-z-]+\//); A = substr(file, RSTART + 8, RLENGTH - 9)
            B = ""
            if (match(imp, /@modules\/[a-z-]+\//)) {
              B = substr(imp, RSTART + 9, RLENGTH - 10)
            } else if (match(imp, ("/(" mods ")/(domain|application|infrastructure|presentation)"))) {
              s = substr(imp, RSTART + 1, RLENGTH - 1); split(s, parts, "/"); B = parts[1]
            }
            if (B != "" && B != A) print file
          }' | sort | uniq -c | awk '{print $2 "\t" $1}' | sort
      ;;
    # ЧУЖИЕ ЗАПИСИ Prisma (foreign-writes): вызовы записи по модели, владельцем
    # которой модуль НЕ является. Карта владения — MODEL_OWNERS выше.
    #   • считаются ТОЛЬКО запись: create/createMany/update/updateMany/delete/
    #     deleteMany/upsert. ЧТЕНИЯ (find*, count, aggregate, groupBy) не
    #     считаются: ADR GAP-51 легализует read-only межмодульный доступ, и
    #     смешение этих классов сделало бы гард невыполнимым;
    #    ловится и `prisma.x.update()`, и клиент транзакции `tx.x.update()`
    #     (внутри $transaction чужая таблица мутируется точно так же);
    #   • строчки-комментарии не считаются — комментарий не пишет в БД.
    # Анти-вакуум: карта обязана покрывать ВСЕ модели схемы в обе стороны —
    # модель без владельца и владелец у убранной модели дают exit 2.
    foreign-writes)
      SCHEMA_MODELS=$(grep -E '^[[:space:]]*model[[:space:]]+[A-Za-z0-9_]+' "$PRISMA_SCHEMA" 2>/dev/null |
        awk '{print $2}' || true)
      # Карта многострочная (читаемость) — для сверок приводим к одной строке.
      OWNS=$(printf '%s' "$MODEL_OWNERS" | tr '\n' ' ')
      if [ -z "$SCHEMA_MODELS" ]; then
        echo "tech-debt [foreign-writes]: нет модели в $PRISMA_SCHEMA — детектору нечего сверять, карта владения повисла" >&2
        return 2
      fi
      for m in $SCHEMA_MODELS; do
        case " $OWNS " in
          *" $m:"*) ;;
          *)
            echo "tech-debt [foreign-writes]: модель $m есть в $PRISMA_SCHEMA, но нет в MODEL_OWNERS (scripts/bin/tech-debt) — добавь '$m:<модуль-владелец>', иначе чужие записи в неё невидимы для гарда" >&2
            return 2
            ;;
        esac
      done
      for pair in $MODEL_OWNERS; do
        m=${pair%%:*}
        FOUND=0
        for s in $SCHEMA_MODELS; do
          [ "$s" = "$m" ] && FOUND=1
        done
        if [ "$FOUND" = 0 ]; then
          echo "tech-debt [foreign-writes]: MODEL_OWNERS ссылается на модель $m, которой нет в $PRISMA_SCHEMA — убери строку из карты" >&2
          return 2
        fi
      done
      if [ ! -d apps/api/src/modules ]; then
        echo "tech-debt [foreign-writes]: нет apps/api/src/modules — гарду нечего сканировать (анти-вакуум: пустое дерево это FAIL, не OK)" >&2
        return 2
      fi
      # Файлы подаются в awk ЧЕРЕЗ -exec: `find | awk` без аргументов читал бы
      # список файлов как данные и молча выдавал пустой результат.
      find apps/api/src/modules -name '*.ts' ! -name '*.spec.ts' ! -name '*.test.ts' \
        ! -name '*.mock.ts' ! -path '*__tests__*' \
        -exec awk -v owners="$(printf '%s' "$MODEL_OWNERS" | tr '\n' ' ')" '
          BEGIN {
            WRITE = "(createMany|updateMany|deleteMany|create|update|delete|upsert)"
            n = split(owners, pairs, " ")
            for (i = 1; i <= n; i++) {
              if (pairs[i] == "") continue
              split(pairs[i], kv, ":")
              acc = tolower(substr(kv[1], 1, 1)) substr(kv[1], 2)
              # Модель может иметь несколько владельцев, если граница в
              # MODULE_BOUNDARIES разделена по ответственностям (users: таблица
              # §3.2, регистрация и сессии §2.1). Дубли ключа в карте =
              # несколько владельцев; гард тогда ловит именно третьих.
              OWNER[acc] = (acc in OWNER) ? OWNER[acc] " " kv[2] : kv[2]
            }
          }
          /^[[:space:]]*(\/\/|\/\*|\*)/ { next }
          {
            file = FILENAME; gsub(/\\/, "/", file)
            if (!match(file, /modules\/[^\/]+\//)) next
            mod = substr(file, RSTART + 8, RLENGTH - 9)
            line = $0
            while (match(line, "\\.[A-Za-z0-9_]+\\." WRITE "\\(")) {
              seg = substr(line, RSTART + 1, RLENGTH - 2)
              d = index(seg, ".")
              acc = substr(seg, 1, d - 1)
              if (acc in OWNER) {
                isOwner = 0
                ownerCount = split(OWNER[acc], ownerList, " ")
                for (oi = 1; oi <= ownerCount; oi++) {
                  if (ownerList[oi] == mod) isOwner = 1
                }
                if (!isOwner) hits[file]++
              }
              line = substr(line, RSTART + RLENGTH)
            }
          }
          END { for (f in hits) printf "%s\t%d\n", f, hits[f] }
        ' {} + | sort
      ;;
    # presentation-слой ходит в БД в обход application-слоя и фасадов
    # (AI_DEVELOPMENT_RULES §3.3 — пример «❌ логика в controller» там же и
    # показан: `prisma.user.findUnique` внутри контроллера). Считаются ЛЮБЫЕ
    # обращения к моделям Prisma — и чтения, и записи, и по чужому клиенту
    # транзакции `tx`:
    #   • чужие ЗАПИСИ ловит foreign-writes, но запись в СВОЮ таблицу из
    #     контроллера не ловил никто — её закрыло именно это правило;
    #   • чтения из presentation обходят фасад ровно так же, как обходили бы
    #     границу модуля, поэтому класс тоже здесь, а не в cross-module-imports.
    # Правило заведено ПО ФАКТУ, а не с нуля: базлайн — 9 файлов / 37 вхождений
    # на 2026-10-05. С этого момента он может только уменьшаться: рост → FAIL,
    # погасил и не ужмят базлайн → STALE.
    # Анти-вакуум: если каталогов presentation вообще нет, детектор exit 2 —
    # пустое дерево это не «ноль нарушений», а оглохший гард.
    presentation-db)
      DIRS=$(ls -d apps/api/src/modules/*/presentation 2>/dev/null || true)
      if [ -z "$DIRS" ]; then
        echo "tech-debt [presentation-db]: нет apps/api/src/modules/*/presentation — гарду нечего сканировать (анти-вакуум: пустое дерево это FAIL, не OK)" >&2
        return 2
      fi
      # $DIRS без кавычек намеренно: список каталогов из ls разбивается на слова.
      grep -rnoE '\b(prisma|tx)\.[a-zA-Z][A-Za-z0-9]*\.(findFirst|findMany|findFirstOrThrow|findUnique|findUniqueOrThrow|count|aggregate|groupBy|create|createMany|update|updateMany|delete|deleteMany|upsert)\(' \
        $DIRS --include='*.ts' 2>/dev/null |
        grep -vE '\.spec\.ts:|\.test\.ts:' |
        cut -d: -f1 | sed 's|\\|/|g' | sort | uniq -c |
        awk '{print $2 "\t" $1}' | sort
      ;;
    # Ключи входных Zod-схем в camelCase вместо snake_case (API_CONVENTIONS §2.2).
    # Почему это долг, а не вкусовщина: имя ключа — часть контракта, и расхождение
    # с тем, что реально шлёт клиент, не видно НИКИМ, кроме самого клиента. В
    # партнёрке так жили три дефекта: схема ждала `acceptTerms`, оба клиента шлют
    # `accept_terms` → регистрация отбивалась с «примите условия» при поставленной
    # галочке (#195); `displayName`/`revshareRate`/`suspendedReason` в админских
    # схемах → PATCH отвечал 200 и ничего не менял (#198). tsc, ESLint и юнит-спеки
    # не ловят: они не знают, что шлёт браузер.
    # Считаются ключи вида `someKey: z.…` с начала строки в presentation/dto/*.ts —
    # то есть ровно те, что приходят из тела или query запроса.
    # Базлайн заведён ПО ФАКТУ (2026-10-07): 3 ключа в 3 файлах. Два из них —
    # живые контракты админки (`userIds` рассылки, `htmlBody` письма), третий —
    # намеренный двойной приём `isPopular` рядом со `is_popular` (комментарий в
    # admin-game.dto.ts). Ужимать базлайн можно только вместе с клиентом.
    # Анти-вакуум: нет каталога dto → exit 2, иначе «ноль нарушений» означает
    # «гард оглох», как в прежнем G7.
    dto-key-naming)
      FILES=$(ls apps/api/src/modules/*/presentation/dto/*.ts 2>/dev/null || true)
      if [ -z "$FILES" ]; then
        echo "tech-debt [dto-key-naming]: нет apps/api/src/modules/*/presentation/dto/*.ts — гарду нечего сканировать (анти-вакуум: пустое дерево это FAIL, не OK)" >&2
        return 2
      fi
      # $FILES без кавычек намеренно: список файлов из ls разбивается на слова.
      grep -rnoE '^[[:space:]]+[a-z]+[A-Za-z0-9_]*[A-Z][A-Za-z0-9]*:[[:space:]]*z\.' \
        $FILES 2>/dev/null |
        grep -vE '\.spec\.ts:' |
        cut -d: -f1 | sed 's|\\|/|g' | sort | uniq -c |
        awk '{print $2 "\t" $1}' | sort
      ;;
    *)
      echo "tech-debt: неизвестное правило '$1' (см. tech-debt list)" >&2
      return 2
      ;;
  esac
}

NAMES='raw-error nest-exceptions eslint-disable money-number use-case-specs service-specs cross-module-imports foreign-writes presentation-db dto-key-naming'

# Имя правила проверяется ДО любого редиректа в tech-debt/: `gen <опечатка>`
# ранее создавал пустой tech-debt/<опечатка>.txt, который потом попадал в git
# (так был заведён отслеживаемый tech-debt/gen.txt коммитом e07de5f).
is_known_name() {
  for known in $NAMES; do
    [ "$known" = "$1" ] && return 0
  done
  return 1
}

# Базлайн и вывод детектора к общему виду `тег<TAB>путь<TAB>число`:
# строка без числа (use-case-specs) = 1, повторный путь суммируется, CR
# из windows-копи basefiles отбрасывается. Тег обязателен: `awk NR==FNR`
# на пустом первом файле принимает базлайн за факт, а пустой базлайн —
# штатная ситуация («долга нет»), см. raw-error после погашения G17.
normalise() {
  awk -F'\t' -v tag="$2" '
    {
      path = $1
      gsub(/\r/, "", path)
      if (path == "") next
      count = ($2 ~ /^[0-9]+$/) ? $2 + 0 : 1
      total[path] += count
    }
    END { for (p in total) printf "%s\t%s\t%d\n", tag, p, total[p] }
  ' "$1"
}

# Различия факта и базлайна: GROW — число выросло (или появился новый путь),
# STALE — число упало или путь исчез (базлайн надо ужать).
diff_state() {
  awk -F'\t' '
    $1 == "C" { fact[$2] = $3 + 0; next }
    $1 == "B" { base[$2] = $3 + 0 }
    END {
      for (p in fact) {
        b = (p in base) ? base[p] : 0
        if (fact[p] > b) printf "GROW\t%s\t%d\t%d\n", p, b, fact[p]
        else if (fact[p] < b) printf "STALE\t%s\t%d\t%d\n", p, b, fact[p]
      }
      for (p in base)
        if (!(p in fact)) printf "STALE\t%s\t%d\t0\n", p, base[p]
    }
  ' "$TMPD/cur.n" "$TMPD/bl.n" | sort
}

TAB=$(printf '\t')

# Подменённый корень сканирования: `detect` — всегда, `check` — тоже (он только
# читает базлайн). `gen` запрещён: иначе ловушка из temp-дерева записалась бы в
# вечный базлайн. Нужен scripts/bin/guard-selftest — негативному тесту гардов.
root_override_allowed() {
  [ -z "${TECH_DEBT_ROOT:-}" ] && return 0
  [ "$1" = gen ] || return 0
  echo "tech-debt gen: TECH_DEBT_ROOT не принимается (базлайн пишется только из рабочего дерева)" >&2
  exit 2
}

case "${1:-}" in
  list)
    echo "$NAMES"
    ;;
  detect)
    shift
    [ $# -eq 1 ] || { echo "usage: tech-debt detect <name>" >&2; exit 2; }
    is_known_name "$1" || {
      echo "tech-debt detect: неизвестное правило '$1' (см. tech-debt list)" >&2
      exit 2
    }
    detect "$1"
    exit $?
    ;;
  gen)
    root_override_allowed gen
    shift
    [ "${1:-}" = "all" ] && set -- $NAMES
    [ $# -gt 0 ] || { echo "usage: tech-debt gen <name>...|all" >&2; exit 2; }
    for name in "$@"; do
      is_known_name "$name" || {
        echo "tech-debt gen: неизвестное правило '$name' (см. tech-debt list)" >&2
        exit 2
      }
    done
    mkdir -p "$DIR"
    TMPD=$(mktemp -d) || exit 2
    trap 'rm -rf "$TMPD"' EXIT
    for name in "$@"; do
      # Пишем во временный файл и подменяем только успешный прогон: упавший
      # детектор не должен оставить обрезанный базлайн.
      detect "$name" > "$TMPD/out" || exit 2
      cat "$TMPD/out" > "$DIR/$name.txt"
      printf '%-22s %s записей(ь) в %s\n' "$name" \
        "$(wc -l < "$DIR/$name.txt" | tr -d ' ')" "$DIR/$name.txt"
    done
    ;;
  check)
    shift
    ALLOW_STALE=0
    NAMES_ARG=''
    for arg in "$@"; do
      if [ "$arg" = "--allow-stale" ]; then
        ALLOW_STALE=1
      else
        NAMES_ARG="$NAMES_ARG $arg"
      fi
    done
    # Имена без пробелов, поэтому разбивка по словам здесь и ожидается.
    set -- $NAMES_ARG
    [ "${1:-}" = "all" ] && set -- $NAMES
    [ $# -gt 0 ] || {
      echo "usage: tech-debt check [--allow-stale] <name>...|all" >&2
      exit 2
    }
    TMPD=$(mktemp -d) || exit 2
    trap 'rm -rf "$TMPD"' EXIT
    RC=0
    for name in "$@"; do
      if ! is_known_name "$name"; then
        echo "tech-debt check: неизвестное правило '$name' (см. tech-debt list)"
        RC=2
        continue
      fi
      BL="$DIR/$name.txt"
      if [ ! -f "$BL" ]; then
        echo "❌ tech-debt [$name]: нет базлайна $BL — сгенерируй: sh scripts/bin/tech-debt gen $name"
        RC=2
        continue
      fi
      detect "$name" > "$TMPD/cur" || exit 2
      normalise "$TMPD/cur" C > "$TMPD/cur.n"
      normalise "$BL" B > "$TMPD/bl.n"
      DIFF=$(diff_state)
      GROW=$(printf '%s\n' "$DIFF" | grep "^GROW" || true)
      STALE=$(printf '%s\n' "$DIFF" | grep "^STALE" || true)
      if [ -n "$GROW" ]; then
        echo "❌ tech-debt [$name]: долг ВЫРОС относительно $BL:"
        printf '%s\n' "$GROW" | while IFS="$TAB" read -r _tag path base now; do
          [ -n "$path" ] || continue
          printf '   %s: базлайн %s → факт %s\n' "$path" "$base" "$now"
        done
        echo "   Новых нарушений допускать нельзя — почини или обоснуй в PR."
        RC=1
      fi
      if [ -n "$STALE" ]; then
        echo "⚠️  tech-debt [$name]: часть базлайна погашена — ужми $BL (sh scripts/bin/tech-debt gen $name):"
        printf '%s\n' "$STALE" | while IFS="$TAB" read -r _tag path base now; do
          [ -n "$path" ] || continue
          printf '   %s: базлайн %s → факт %s\n' "$path" "$base" "$now"
        done
        # Погашенный долг без `gen` — это не «всё хорошо»: базлайн врёт
        # следующему изменению, а гард тихо пропускает рост до его величины.
        # Отсюда ненулевой exit; --allow-stale — сознательный переходный режим.
        if [ "$ALLOW_STALE" = 0 ] && [ "$RC" = 0 ]; then
          RC=3
        fi
      fi
      if [ -z "$GROW" ] && [ -z "$STALE" ]; then
        echo "✅ tech-debt [$name]: OK ($(wc -l < "$TMPD/cur" | tr -d ' ') записей = базлайну)"
      fi
    done
    exit $RC
    ;;
  *)
    echo "usage: tech-debt gen|check [--allow-stale] <name>...|all; tech-debt detect <name>; tech-debt list" >&2
    exit 2
    ;;
esac
