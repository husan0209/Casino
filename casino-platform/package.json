{
  "name": "casino-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @casino/api dev",
    "dev:web": "pnpm --filter @casino/web dev",
    "dev:admin": "pnpm --filter @casino/admin dev",
    "lint": "pnpm -r lint",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter @casino/api test:watch",
    "test:cov": "pnpm --filter @casino/api test:cov",
    "db:generate": "pnpm --filter @casino/database generate",
    "db:migrate": "pnpm --filter @casino/database migrate:dev",
    "db:seed": "pnpm --filter @casino/database seed",
    "format": "prettier --write .",
    "format:check": "prettier . --check",
    "commitlint": "commitlint --edit",
    "load-test:wallet": "k6 run infra/load-tests/wallet-concurrency.js",
    "prepare": "echo hooks managed via casino-platform/scripts/setup-hooks.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@typescript-eslint/eslint-plugin": "7.2.0",
    "@typescript-eslint/parser": "7.2.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "lint-staged": "^15.2.0",
    "prettier": "^3.4.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "sh scripts/bin/eslint --fix",
      "sh scripts/bin/prettier --write"
    ],
    "*.{json,md,yml,yaml,css,scss}": [
      "sh scripts/bin/prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.1.1"
    },
